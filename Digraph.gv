digraph {
	node [fontname="Helvetica,Arial,sans-serif" fontsize=12 shape=padded_box]
	nodesep=0.6 ranksep=0.6
	rankdir=LR
	"(0, 0)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(0, 0)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">boundD, r_-1, boundL, a1, r_0, a3, a0</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(1, 0)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(1, 0)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">a2, r_-1, boundL, r_0, a3, a0</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(1, 1)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(1, 1)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">a2, a1, r_0</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(0, 1)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(0, 1)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">a3, r_0</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(2, 0)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(2, 0)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">a2, r_-1, boundL, a1, r_0, a3</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(2, 1)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(2, 1)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">a2, r_0</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(2, 2)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(2, 2)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">TS, r_-10</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(1, 2)" [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
            <TR><TD BGCOLOR="#EAEAEA"><B>(1, 2)</B></TD></TR>
            <TR><TD BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">a0, r_0</FONT></TD></TR>
            </TABLE>
            > shape=none]
	"(0, 0)" -> "(1, 0)" [arrowhead=vee color="#4a4a4a"]
	"(0, 0)" -> "(0, 0)" [arrowhead=vee color="#4a4a4a"]
	"(1, 0)" -> "(1, 0)" [arrowhead=vee color="#4a4a4a"]
	"(1, 0)" -> "(1, 1)" [arrowhead=vee color="#4a4a4a"]
	"(1, 0)" -> "(2, 0)" [arrowhead=vee color="#4a4a4a"]
	"(1, 1)" -> "(0, 1)" [arrowhead=vee color="#4a4a4a"]
	"(1, 1)" -> "(1, 2)" [arrowhead=vee color="#4a4a4a"]
	"(0, 1)" -> "(0, 0)" [arrowhead=vee color="#4a4a4a"]
	"(2, 0)" -> "(1, 0)" [arrowhead=vee color="#4a4a4a"]
	"(2, 0)" -> "(2, 0)" [arrowhead=vee color="#4a4a4a"]
	"(2, 0)" -> "(2, 1)" [arrowhead=vee color="#4a4a4a"]
	"(2, 1)" -> "(2, 2)" [arrowhead=vee color="#4a4a4a"]
	"(1, 2)" -> "(2, 2)" [arrowhead=vee color="#4a4a4a"]
}
